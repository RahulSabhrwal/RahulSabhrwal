import tkinter as tk
from time import strftime

# Create a window
root = tk.Tk()
root.title("Digital Clock")

# Set window size and make it non-resizable
root.geometry("400x150")
root.resizable(0, 0)

# Define a function to update the time
def time():
    # Get current time in 12-hour format
    current_time = strftime('%I:%M:%S %p')
    
    # Update the label with the current time
    label.config(text=current_time, bg='black')
    
    # Call the time function every 1000 ms (1 second)
    label.after(1000, time)

# Create a label to display the time
label = tk.Label(root, font=('calibri', 50, 'bold'), background='black', foreground='white')

# Place the label in the window
label.pack(anchor='center')

# Call the time function to update the time
time()

# Run the Tkinter event loop
root.mainloop()
