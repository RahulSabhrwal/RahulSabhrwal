# Importing regEX module
import re

# Improved regular expression for email validation
email_conditions = "^[a-z]+[\._]?[a-z 0-9]+[@]\w+[.]\w{2,3}$"

user_email = input("Enter your email:-  ")

# Checking the conditions by using re.search
if re.search(email_conditions, user_email):
    print(" Right email ")

else:
    print(" Wrong email ")
